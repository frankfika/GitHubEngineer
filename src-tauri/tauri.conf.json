{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitHub Engineer",
  "version": "1.0.0",
  "identifier": "com.opencsg.github-engineer",
  "build": {
    "beforeDevCommand": ".venv/bin/python scripts/build_desktop_sidecar.py && .venv/bin/python -m src.main --config .ghe/config.yml --serve --serve-host 127.0.0.1",
    "beforeBuildCommand": ".venv/bin/python scripts/build_desktop_sidecar.py",
    "devUrl": "http://127.0.0.1:8765/ui/",
    "frontendDist": "../desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GitHub Engineer",
        "width": 1180,
        "height": 760,
        "minWidth": 820,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' http://127.0.0.1:8765"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/github-engineer-backend"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist"
    },
    "category": "DeveloperTool",
    "shortDescription": "AI maintainer assistant for GitHub repositories"
  }
}
